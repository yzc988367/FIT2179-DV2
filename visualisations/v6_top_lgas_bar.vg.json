{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top LGAs by Share of Residents Aged 65+, 2024",
    "subtitle": "Top local government areas ranked by percentage of residents aged 65+",
    "fontSize": 23,
    "subtitleFontSize": 16,
    "anchor": "start"
  },
  "width": "container",
  "height": 620,
  "data": {"url": "data/older_population_lga.csv"},
  "transform": [
    {
      "calculate": "toNumber(datum.percent_65_plus)",
      "as": "percent_65_plus_num"
    },
    {
      "window": [{"op": "row_number", "as": "rank"}],
      "sort": [
        {"field": "percent_65_plus_num", "order": "descending"},
        {"field": "lga_name", "order": "ascending"}
      ]
    },
    {"filter": "datum.rank <= 15"},
    {"calculate": "datum.lga_name + ', ' + datum.state", "as": "label"},
    {"calculate": "format(datum.percent_65_plus_num, '.1f') + '%'", "as": "percent_label"}
  ],
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "sort": {"field": "percent_65_plus_num", "order": "descending"},
      "title": null,
      "axis": {"labelFontSize": 15, "labelLimit": 360}
    },
    "x": {
      "field": "percent_65_plus_num",
      "type": "quantitative",
      "title": "% aged 65+",
      "axis": {"grid": true, "gridDash": [2, 4], "labelFontSize": 15, "titleFontSize": 16},
      "scale": {"domain": [0, 55]}
    },
    "tooltip": [
      {"field": "lga_name", "type": "nominal", "title": "LGA"},
      {"field": "state", "type": "nominal", "title": "State"},
      {"field": "percent_65_plus_num", "type": "quantitative", "format": ".1f", "title": "% aged 65+"},
      {"field": "pop_65_plus", "type": "quantitative", "format": ",", "title": "People 65+"},
      {"field": "median_age", "type": "quantitative", "format": ".1f", "title": "Median age"}
    ]
  },
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 3, "color": "#9a3412", "opacity": 0.8},
      "encoding": {
        "x2": {"datum": 0}
      }
    },
    {
      "mark": {"type": "circle", "size": 210, "color": "#c2410c", "stroke": "#fff7ed", "strokeWidth": 1.3}
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 13,
        "fontSize": 15,
        "fontWeight": 700,
        "color": "#44403c"
      },
      "encoding": {
        "text": {"field": "percent_label", "type": "nominal"}
      }
    },
    {
      "transform": [{"filter": "datum.rank == 1"}],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": -24,
        "dy": -18,
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#7c2d12"
      },
      "encoding": {
        "text": {"value": "highest share"}
      }
    }
  ],
  "config": {
    "font": "Inter, Segoe UI, Arial, sans-serif",
    "axis": {"domainColor": "#a8a29e", "tickColor": "#a8a29e", "labelColor": "#44403c", "titleColor": "#44403c"},
    "view": {"stroke": null}
  }
}
