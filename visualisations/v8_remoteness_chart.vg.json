{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": ["Proportion of Population Aged 65+", "by Remoteness Category"],
    "subtitle": "AIHW reports inner regional areas as the oldest remoteness category",
    "fontSize": 23,
    "subtitleFontSize": 16,
    "lineHeight": 27,
    "anchor": "start"
  },
  "width": "container",
  "height": 390,
  "data": {"url": "data/older_population_remoteness.csv"},
  "transform": [
    {
      "calculate": "datum.remoteness == 'Inner regional' ? datum.remoteness + ' (highest)' : datum.remoteness == 'Very remote' ? datum.remoteness + ' (lowest)' : datum.remoteness",
      "as": "label"
    }
  ],
  "mark": {"type": "bar", "cornerRadiusEnd": 3},
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {"labelFontSize": 15, "labelLimit": 260}
    },
    "x": {
      "field": "percent_65_plus",
      "type": "quantitative",
      "title": "% aged 65+",
      "axis": {"grid": true, "gridDash": [2, 4], "labelFontSize": 15, "titleFontSize": 16},
      "scale": {"domain": [0, 25]}
    },
    "color": {
      "field": "percent_65_plus",
      "type": "quantitative",
      "title": "% aged 65+",
      "scale": {"scheme": "oranges", "domain": [0, 25]},
      "legend": null
    },
    "tooltip": [
      {"field": "remoteness", "type": "nominal", "title": "Category"},
      {"field": "percent_65_plus", "type": "quantitative", "format": ".1f", "title": "% aged 65+"},
      {"field": "source", "type": "nominal", "title": "Source"}
    ]
  },
  "config": {
    "font": "Inter, Segoe UI, Arial, sans-serif",
    "axis": {"domainColor": "#a8a29e", "tickColor": "#a8a29e", "labelColor": "#44403c", "titleColor": "#44403c"},
    "view": {"stroke": null}
  }
}
