{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Older Age Structure by State, 2024",
    "subtitle": "Percentage of each state's 65+ population by age band",
    "fontSize": 23,
    "subtitleFontSize": 16,
    "anchor": "start"
  },
  "width": "container",
  "height": 570,
  "data": {"url": "data/older_population_lga.csv"},
  "transform": [
    {
      "aggregate": [
        {"op": "sum", "field": "pop_65_74", "as": "pop_65_74"},
        {"op": "sum", "field": "pop_75_84", "as": "pop_75_84"},
        {"op": "sum", "field": "pop_85_plus", "as": "pop_85_plus"},
        {"op": "sum", "field": "pop_65_plus", "as": "pop_65_plus"}
      ],
      "groupby": ["state"]
    },
    {"fold": ["pop_65_74", "pop_75_84", "pop_85_plus"], "as": ["age_group", "population_count"]},
    {"calculate": "datum.population_count / datum.pop_65_plus * 100", "as": "age_group_share"},
    {
      "calculate": "datum.age_group == 'pop_65_74' ? '65-74' : datum.age_group == 'pop_75_84' ? '75-84' : '85+'",
      "as": "age_label"
    },
    {"calculate": "format(datum.age_group_share, '.0f') + '%'", "as": "share_label"}
  ],
  "encoding": {
    "x": {
      "field": "age_label",
      "type": "nominal",
      "title": "Age group",
      "sort": ["65-74", "75-84", "85+"],
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "labelOverlap": false,
        "labelPadding": 6,
        "titlePadding": 6,
        "labelFontSize": 15,
        "titleFontSize": 16
      }
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "sort": [
        "New South Wales",
        "Victoria",
        "Queensland",
        "South Australia",
        "Western Australia",
        "Tasmania",
        "Northern Territory",
        "Australian Capital Territory",
        "Other Territories"
      ],
      "axis": {"labelFontSize": 14, "labelLimit": 190}
    },
    "tooltip": [
      {"field": "state", "type": "nominal", "title": "State"},
      {"field": "age_label", "type": "nominal", "title": "Age group"},
      {"field": "age_group_share", "type": "quantitative", "format": ".1f", "title": "% of 65+ population"},
      {"field": "population_count", "type": "quantitative", "format": ",", "title": "Population count"}
    ]
  },
  "layer": [
    {
      "mark": {"type": "rect", "stroke": "#ffffff", "strokeWidth": 1.3},
      "encoding": {
        "color": {
          "field": "age_group_share",
          "type": "quantitative",
          "title": "% of 65+ population",
          "scale": {
            "domain": [0, 65],
            "range": ["#fff7ed", "#fed7aa", "#fb923c", "#c2410c", "#7c2d12"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 320,
            "gradientThickness": 14,
            "format": ".0f",
            "labelFontSize": 14,
            "titleFontSize": 15,
            "offset": 40
          }
        }
      }
    },
    {
      "mark": {"type": "text", "fontSize": 15, "fontWeight": 700},
      "encoding": {
        "text": {"field": "share_label", "type": "nominal"},
        "color": {
          "condition": {"test": "datum.age_group_share >= 42", "value": "#fff7ed"},
          "value": "#44403c"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, Segoe UI, Arial, sans-serif",
    "axis": {"domainColor": "#a8a29e", "tickColor": "#a8a29e", "labelColor": "#44403c", "titleColor": "#44403c"},
    "view": {"stroke": null}
  }
}
