{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Number of People Aged 65+ by Local Government Area, 2024",
    "subtitle": "Circle size shows the absolute number of older residents",
    "fontSize": 23,
    "subtitleFontSize": 16,
    "anchor": "start"
  },
  "width": "container",
  "height": 680,
  "projection": {"type": "mercator", "center": [133.5, -27]},
  "layer": [
    {
      "data": {
        "url": "data/australia_lga.topojson",
        "format": {"type": "topojson", "feature": "australia_lga"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e7e5e4",
        "stroke": "#ffffff",
        "strokeWidth": 0.25
      }
    },
    {
      "data": {"url": "data/lga_centroids.csv"},
      "mark": {
        "type": "circle",
        "opacity": 0.7,
        "color": "#c2410c",
        "stroke": "#ffffff",
        "strokeWidth": 0.7
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "pop_65_plus",
          "type": "quantitative",
          "title": "People 65+",
          "scale": {"type": "sqrt", "range": [8, 900], "domain": [0, 450000]},
          "legend": {
            "orient": "bottom-right",
            "format": "~s",
            "labelFontSize": 15,
            "titleFontSize": 16
          }
        },
        "tooltip": [
          {"field": "lga_name", "type": "nominal", "title": "LGA"},
          {"field": "pop_65_plus", "type": "quantitative", "format": ",", "title": "Population 65+"},
          {"field": "percent_65_plus", "type": "quantitative", "format": ".1f", "title": "% aged 65+"}
        ]
      }
    }
  ],
  "config": {
    "font": "Inter, Segoe UI, Arial, sans-serif",
    "legend": {"labelColor": "#44403c", "titleColor": "#44403c"},
    "view": {"stroke": null}
  }
}
