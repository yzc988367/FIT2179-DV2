{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Australians Aged 65 and Over, 2001–2024",
  "width": "container",
  "height": 360,
  "data": {"url": "data/ageing_trend.csv"},
  "mark": {
    "type": "line",
    "point": {"filled": true, "size": 40},
    "color": "#d97706",
    "strokeWidth": 2.5
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "temporal",
      "title": null,
      "axis": {"grid": false, "labelFontSize": 12}
    },
    "y": {
      "field": "percent_65_plus",
      "type": "quantitative",
      "title": "% of population aged 65+",
      "axis": {"grid": true, "gridDash": [2, 4], "labelFontSize": 12},
      "scale": {"domain": [10, 20]}
    },
    "tooltip": [
      {"field": "year", "type": "temporal", "format": "%Y", "title": "Year"},
      {"field": "percent_65_plus", "type": "quantitative", "format": ".2f", "title": "% Aged 65+"},
      {"field": "pop_65_plus", "type": "quantitative", "format": ",",
        "title": "People 65+"}
    ]
  }
}
