{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top 10 LGAs by Share of Residents Aged 85+, 2024",
    "subtitle": "Oldest-old shares are highest in a small group of local areas",
    "fontSize": 19,
    "subtitleFontSize": 14,
    "anchor": "start"
  },
  "width": "container",
  "height": 360,
  "data": {"url": "data/older_population_lga.csv"},
  "transform": [
    {"calculate": "datum.pop_85_plus / datum.total_population * 100", "as": "percent_85_plus"},
    {
      "window": [{"op": "row_number", "as": "rank"}],
      "sort": [{"field": "percent_85_plus", "order": "descending"}]
    },
    {"filter": "datum.rank <= 10"},
    {"calculate": "datum.lga_name + ', ' + datum.state", "as": "label"}
  ],
  "mark": {"type": "bar", "cornerRadiusEnd": 3, "color": "#991b1b"},
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {"labelFontSize": 13, "labelLimit": 300}
    },
    "x": {
      "field": "percent_85_plus",
      "type": "quantitative",
      "title": "% aged 85+",
      "axis": {"grid": true, "gridDash": [2, 4], "labelFontSize": 13, "titleFontSize": 14},
      "scale": {"domain": [0, 8]}
    },
    "tooltip": [
      {"field": "lga_name", "type": "nominal", "title": "LGA"},
      {"field": "state", "type": "nominal", "title": "State"},
      {"field": "percent_85_plus", "type": "quantitative", "format": ".1f", "title": "% aged 85+"},
      {"field": "pop_85_plus", "type": "quantitative", "format": ",", "title": "People 85+"},
      {"field": "median_age", "type": "quantitative", "format": ".1f", "title": "Median age"}
    ]
  },
  "config": {
    "font": "Inter, Segoe UI, Arial, sans-serif",
    "axis": {"domainColor": "#a8a29e", "tickColor": "#a8a29e", "labelColor": "#44403c", "titleColor": "#44403c"},
    "view": {"stroke": null}
  }
}
