{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Percentage of Population Aged 65+ by Local Government Area, 2024",
  "width": "container",
  "height": 500,
  "data": {
    "url": "data/australia_lga.topojson",
    "format": {"type": "topojson", "feature": "australia_lga"}
  },
  "projection": {"type": "mercator", "center": [133.5, -27]},
  "transform": [
    {
      "calculate": "datum.properties.LGA_CODE24",
      "as": "LGA_CODE"
    },
    {
      "lookup": "LGA_CODE",
      "from": {
        "data": {"url": "data/older_population_lga.csv"},
        "key": "lga_code",
        "fields": ["percent_65_plus", "pop_65_plus", "lga_name", "state"]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.2
  },
  "encoding": {
    "color": {
      "field": "percent_65_plus",
      "type": "quantitative",
      "title": "% Aged 65+",
      "scale": {"scheme": "oranges", "domain": [0, 55]},
      "legend": {
        "format": ".0f",
        "orient": "bottom-right",
        "labelFontSize": 11,
        "titleFontSize": 12
      }
    },
    "tooltip": [
      {"field": "properties.LGA_NAME24", "type": "nominal", "title": "LGA"},
      {"field": "state", "type": "nominal", "title": "State"},
      {"field": "percent_65_plus", "type": "quantitative", "format": ".1f",
        "title": "% Aged 65+"},
      {"field": "pop_65_plus", "type": "quantitative", "format": ",",
        "title": "People 65+"}
    ]
  }
}
